<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#121212"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎵" android:textSize="20sp" android:layout_marginEnd="16dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvSongTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Название" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvSongArtist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Исполнитель" android:textColor="#888888" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☆" android:textColor="#888888" android:textSize="24sp" android:layout_marginEnd="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#888888" android:textSize="24sp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
